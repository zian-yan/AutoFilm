# 仓库聚合根
#   autofilm/   —— AutoFilm（Rust）源码，构建工作目录为 autofilm/
#   mediawarp/  —— MediaWarp（Go）源码，以 git submodule 指向 zian-yan/MediaWarp（见 .gitmodules）
#   .github/    —— 仓库级 CI：GitHub Actions 只识别仓库根的 .github/workflows

.workbuddy/

# ---------- AutoFilm：本地配置与运行产物 ----------
autofilm/config/config.yaml
autofilm/config/config.old.yaml
autofilm/config/web.yaml
# 由面板自动生成，内含媒体服务器 API Key；示例见 autofilm/config/mediawarp.example.yaml
autofilm/config/mediawarp.yaml
# 面板登录会话（等同凭据）：不允许进仓库
autofilm/config/.autofilm_sessions.json
autofilm/config/.autofilm_sessions.json.tmp
autofilm/logs/*
autofilm/strm/*
autofilm/media/*
autofilm/target/*
autofilm/alist-client-rs/target/*
autofilm/__pycache__/*
autofilm/.mypy_cache/*

# ---------- MediaWarp：忽略规则由子模块自身 .gitignore 负责 ----------
# mediawarp/ 是 git submodule（zian-yan/MediaWarp），父仓库的 ignore 规则不会穿透进去；
# 其 config/config.yaml、logs/、custom/、dist/、二进制由子模块的 .gitignore 忽略。
# 首次克隆需要 `git clone --recursive` 或 `git submodule update --init --recursive`。

.DS_Store
*bak
*pyc*
